---
import site from '../data/site.json';
import { u } from '../lib/url';
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const links = [
  { href: 'approach/', label: 'Approach' },
  { href: 'work/', label: 'Work' },
  { href: 'impact/', label: 'Impact' },
  { href: 'give/', label: 'Give' },
  { href: 'volunteer/', label: 'Volunteer' },
  { href: 'about/', label: 'About' },
];
const active = (h: string) => here.startsWith('/' + h);
---
<header class="site-header" data-header>
  <div class="bar">
    <a class="brand" href={u('/')} aria-label={`${site.name}, home`}>
      <svg role="img" aria-hidden="true"><use href="#bff-mark" width="100%" height="100%" /></svg>
      <span>Boulder Feet Forward</span>
    </a>
    <nav class="nav" id="site-nav" aria-label="Main" data-nav data-open="false">
      {links.map((l) => <a href={u(l.href)} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="help-link-mobile" href={u('contact/#find-us')} >Need help?</a>
    </nav>
    <div class="header-actions">
      <a class="help-link" href={u('contact/#find-us')}>Need help?</a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark mode">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
      </button>
      <a class="btn btn-primary btn-sm" href={u('give/')}>Give</a>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>
