---
import data from '../data/dimensions.json';

interface Props { id?: string }
const { id = 'wheel' } = Astro.props;

const dims = [...data.dimensions].sort((a, b) => a.order - b.order);
const C = 250, R1 = 236, R0 = 98, BAND = 11, HALF = 22.5;
const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (r: number, deg: number) => [C + r * Math.cos(rad(deg)), C + r * Math.sin(rad(deg))];
const sector = (r0: number, r1: number, a0: number, a1: number) => {
  const [x0, y0] = pt(r1, a0), [x1, y1] = pt(r1, a1), [x2, y2] = pt(r0, a1), [x3, y3] = pt(r0, a0);
  return `M${x0.toFixed(1)} ${y0.toFixed(1)} A${r1} ${r1} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)} L${x2.toFixed(1)} ${y2.toFixed(1)} A${r0} ${r0} 0 0 0 ${x3.toFixed(1)} ${y3.toFixed(1)}Z`;
};
const icons: Record<string, string> = {
  emotional: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  occupational: 'M4 8h16v11H4z M9 8V5h6v3 M4 13h16',
  intellectual: 'M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13C17 4 14 4.5 12 6z M12 6v13',
  environmental: 'M12 21V11 M12 13C8 13 6 10 6 6c4 0 6 3 6 7z M12 11c0-4 2-7 6-7 0 4-2 7-6 7z',
  financial: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7v10 M14.6 9.4c-.4-1-1.4-1.5-2.6-1.5-1.5 0-2.6.7-2.6 1.8s1 1.5 2.6 1.9c1.6.4 2.6.8 2.6 1.9S13.5 15.4 12 15.4c-1.3 0-2.3-.6-2.7-1.6',
  social: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6 M16 5.5a3 3 0 0 1 0 5.8 M18 14.3c2 .7 3 2.8 3 5.7',
  physical: 'M3 12h4l2.5-6 4 12 2.5-6H21',
  spiritual: 'M12 3c.6 4.5 1.5 5.4 6 6-4.5.6-5.4 1.5-6 6-.6-4.5-1.5-5.4-6-6 4.5-.6 5.4-1.5 6-6z M18.5 15.5v4 M16.5 17.5h4',
};
const segs = dims.map((d, i) => {
  const mid = -90 + i * 45;
  const [cx, cy] = pt((R0 + R1 - BAND) / 2 + 2, mid);
  return {
    ...d,
    body: sector(R0, R1 - BAND, mid - HALF, mid + HALF),
    band: sector(R1 - BAND, R1, mid - HALF, mid + HALF),
    hit: sector(R0, R1, mid - HALF, mid + HALF),
    cx, cy,
  };
});
const tiers = data.tiers;
---
<div class="wheel-wrap" data-wheel id={id}>
  <div class="wheel">
    <svg viewBox="0 0 500 500" role="presentation">
      <g role="tablist" aria-label="The eight dimensions of wellness" aria-orientation="horizontal">
        {segs.map((s, i) => (
          <g class="seg" role="tab" tabindex={i === 0 ? 0 : -1} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`${id}-panel`} data-dim={s.slug} aria-label={s.name}>
            <g class="shape">
              <path class="body" d={s.body} />
              <path class="band" d={s.band} />
            </g>
            <path class="hit" d={s.hit} />
            <g transform={`translate(${(s.cx - 15.6).toFixed(1)} ${(s.cy - 36).toFixed(1)}) scale(1.3)`}>
              <g class="ico">{icons[s.slug].split(' M').map((seg, n) => <path d={(n ? 'M' : '') + seg} />)}</g>
            </g>
            <text x={s.cx.toFixed(1)} y={(s.cy + 18).toFixed(1)}>{s.name}</text>
          </g>
        ))}
      </g>
      <circle class="hub" cx={C} cy={C} r={R0 - 10} />
      <text class="hub-t" x={C} y={C - 18}>Whole</text>
      <text class="hub-t" x={C} y={C + 10}>person</text>
      <text class="hub-s" x={C} y={C + 36}>Eight dimensions</text>
    </svg>
  </div>
  <div class="dim-panel" id={`${id}-panel`} role="tabpanel" aria-live="polite" data-dim={segs[0].slug}>
    {segs.map((s, i) => (
      <div class="dim-content" data-dim={s.slug} hidden={i !== 0}>
        <h3>{s.name}</h3>
        <p class="sum">{s.summary}</p>
        <ol class="steps">
          {s.tiers.map((t, n) => (
            <li>
              <span class="n" aria-hidden="true">{n + 1}</span>
              <span><span class="t">{tiers[n].name}</span><span class="d">{t}</span></span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</div>
<div class="wheel-list">
  {segs.map((s) => (
    <section data-dim={s.slug} class="measure" style="margin-bottom:1.6rem">
      <h3>{s.name}</h3>
      <p>{s.summary}</p>
      <ol>{s.tiers.map((t, n) => <li><strong>{tiers[n].name}:</strong> {t}</li>)}</ol>
    </section>
  ))}
</div>
