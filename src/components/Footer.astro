---
import site from '../data/site.json';
import Newsletter from './Newsletter.astro';
import { u } from '../lib/url';
const year = new Date().getFullYear();
const icons: Record<string, string> = {
  facebook: '<path d="M14.2 8.4h2.4V5h-2.8c-2.6 0-4.1 1.6-4.1 4.2V11.5H7.2v3.4h2.5V21h3.5v-6.1h2.7l.5-3.4h-3.2V9.6c0-.8.4-1.2 1-1.2z" fill="currentColor" stroke="none"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/>',
  x: '<path d="M4.5 4.5h3.9l11.1 15h-3.9z"/><path d="M19 4.5l-6.2 6.9M5 19.5l6.2-6.9"/>',
};
---
<footer class="site-footer">
  <svg class="skyline" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path fill="var(--sunken)" d="M0 74 C 110 44, 200 34, 310 52 S 500 92, 620 72 S 800 26, 930 42 S 1100 82, 1200 54 V120 H0 Z" />
    <path fill="none" stroke="var(--art)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" d="M0 74 C 110 44, 200 34, 310 52 S 500 92, 620 72 S 800 26, 930 42 S 1100 82, 1200 54" />
  </svg>
  <div class="footer-body">
  <div class="wrap flush" style="width:min(100% - 2 * var(--gutter), var(--maxw)); margin-inline:auto;">
    <div class="footer-grid">
      <div>
        <svg class="footer-lockup" role="img" aria-label="Boulder Feet Forward"><use href="#bff-lockup" width="100%" height="100%" /></svg>
        <p>{site.tagline} Every day. Step by step.</p>
        <p class="social" role="list" aria-label="Follow us">
          {site.social.map((s) => (
            <a href={s.url} rel="noopener" role="listitem" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.label.toLowerCase()]} />
            </a>
          ))}
        </p>
      </div>
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href={u('approach/')}>Our approach</a></li>
          <li><a href={u('work/')}>Our work</a></li>
          <li><a href={u('impact/')}>Impact</a></li>
          <li><a href={u('give/')}>Give</a></li>
          <li><a href={u('volunteer/')}>Volunteer</a></li>
          <li><a href={u('about/')}>About us</a></li>
        </ul>
      </div>
      <div>
        <h2>Find us</h2>
        <ul>
          <li>Tuesdays, 2:30 PM</li>
          <li>Fridays, 11:00 AM</li>
          <li>{site.findUs.place}</li>
          <li><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li>{site.contact.addressLines.join(', ')}</li>
        </ul>
      </div>
      <div>
        <h2>Stay in touch</h2>
        <p class="small muted">News from the park, a few times a year. No spam.</p>
        <Newsletter compact />
      </div>
    </div>
    <div class="fine">
      <p>&copy; {year} Boulder Feet Forward. A peer-led street outreach team in Boulder, Colorado.</p>
      <p>Website designed and built as a gift by Benjamin Life (<a href="https://x.com/omniharmonic" rel="noopener">@omniharmonic</a>).</p>
    </div>
  </div>
  </div>
</footer>
