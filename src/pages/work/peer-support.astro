---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import PageHead from '../../components/PageHead.astro';
import DraftNote from '../../components/DraftNote.astro';
import partners from '../../data/partners.json';
import { u } from '../../lib/url';
const entry = (await getEntry('pages', 'peer-support'))!;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <Stage>
    <PageHead title="Support from someone who has been there." lead="Zero-barrier peer support, starting wherever a person is." />
    <section class="section tight" data-step>
      <div class="wrap">
        <DraftNote draft={entry.data.draft} />
        <div class="prose"><Content /></div>
        <div class="btn-row" style="margin-top:2rem">
          <a class="btn btn-ghost" href={u('approach/')}>The eight dimensions</a>
          <a class="btn btn-ghost" href={u('work/case-management/')}>Case management</a>
        </div>
      </div>
    </section>
    <section class="section tight" data-step aria-labelledby="reading">
      <div class="wrap">
        <h2 id="reading" style="font-size:clamp(1.6rem,1.1rem+1.6vw,2.3rem)">Further reading</h2>
        <ul class="links-list measure">
          {partners.reading.map((r) => <li><a href={r.url} rel="noopener">{r.name}</a></li>)}
        </ul>
      </div>
    </section>
  </Stage>
</Base>
