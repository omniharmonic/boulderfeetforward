---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import PageHead from '../components/PageHead.astro';
import site from '../data/site.json';
---
<Base title="Contact" description="Find Boulder Feet Forward in Central Park on Tuesdays and Fridays, or reach us by phone and email.">
  <Stage>
    <PageHead title="Find us, or reach us." lead="The easiest way to find us is in the park. If you need something and cannot get there, call." />
    <section class="section tight" data-step>
      <div class="wrap">
        <div class="contact-block">
          <div id="find-us">
            <h2>Come to the park.</h2>
            <p class="measure">{site.findUs.note}</p>
            <ul class="sched">
              <li><strong>Tuesdays in the Park</strong>, 2:30 PM</li>
              <li><strong>Friday Breakfast Club</strong>, 11:00 AM, with drop-in hours right after</li>
              <li>{site.findUs.place}</li>
            </ul>
            <p class="small muted" style="margin-top:1rem">Next Tuesday: <span class="next-date" data-next="Tuesday"></span><br />Next Friday: <span class="next-date" data-next="Friday"></span></p>
          </div>
          <div>
            <h2>Call or write.</h2>
            <a class="big-link" href={`tel:${site.contact.phoneHref}`}>{site.contact.phone}</a>
            <a class="big-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            <p style="margin-top:1rem">{site.contact.addressLines.join(', ')}</p>
            <p class="small muted">Follow along: {site.social.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < site.social.length - 1 ? ', ' : ''}</>)}</p>
          </div>
        </div>
      </div>
    </section>
  </Stage>
</Base>
